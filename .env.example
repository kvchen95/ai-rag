# =========================
# ai-rag local dev (.env)
# Copy to .env and adjust.
# =========================

# --- General ---
TZ=Asia/Shanghai
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL (PG is source of truth) ---
# Image must ship the pgvector extension: chunks.embedding_dense is vector(512).
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=ai_rag
POSTGRES_USER=ai_rag
POSTGRES_PASSWORD=ai_rag_dev_password
POSTGRES_PORT=5432
# Host-side DSN for running `pytest -c api/pytest.ini` or the app outside Docker.
# In-container api/worker get their own DSN assembled in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://ai_rag:ai_rag_dev_password@127.0.0.1:5432/ai_rag

# --- Qdrant (dense + BM25 sparse in one collection) ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=kb_chunks
QDRANT_URL=http://127.0.0.1:6333

# --- API / Web ---
API_PORT=8000
WEB_PORT=5173

# --- Model services (all-in-docker, CPU) ---
# embedding/rerank run as local CPU containers (Hugging Face TEI).
# Models per 详细设计.md: bge-small-zh-v1.5 (512 维稠密) + bge-reranker-base.
# To switch to an external OpenAI-compatible gateway, override the *_BASE_URL/*_API_KEY.
# Endpoints: embeddings -> POST {EMBEDDING_BASE_URL}/embeddings (OpenAI style)
#            rerank     -> POST {RERANK_BASE_URL}/rerank       (TEI native: {"query","texts"})
EMBEDDING_PORT=7997
EMBEDDING_BASE_URL=http://embedding:8000/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

RERANK_PORT=7999
RERANK_BASE_URL=http://rerank:8000
RERANK_API_KEY=local
RERANK_MODEL=BAAI/bge-reranker-base

# Batch size cap for the model services
MODEL_BATCH_SIZE=32
# Optional Hugging Face mirror if huggingface.co is blocked, e.g. https://hf-mirror.com
HF_ENDPOINT=

# 生成与判别走外部网关（OpenAI 兼容 /chat/completions）。留空 = 未配置：
# 服务能起来，有证据的问答会走 fallback 的系统档（model_timeout），
# 而不是启动失败——检索、门控、审计在没有生成模型时仍然有价值（评测与门控标定要用）。
# Temperature 固定 0（§9.2），**不做成配置项**：它是硬约束不是旋钮。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# SSE 逐字增量的字符数（§附录 C.2 的 token 事件粒度）。不是业务阈值，是传输粒度：
# 2 字一帧在中文下接近打字机观感，一次 300 字答案约 150 帧。
SSE_TOKEN_CHUNK_CHARS=2

# --- Retrieval / gate thresholds (from 详细设计.md) ---
# Gate: <GATE_REJECT_NONE => reject, [NONE,LOW) => low-confidence reject+suspects, >=LOW => pass to checks
GATE_REJECT_NONE=0.20
GATE_REJECT_LOW=0.40
# Multi-hop max
MAX_HOPS=3
# Retrieval: per-route topK, rerank window
RETRIEVAL_TOP_K=30
RERANK_TOP_N_MIN=5
RERANK_TOP_N_MAX=8
# 精排候选上限（§7.5「上限 50，超了按名次截」）
RERANK_CANDIDATES_MAX=50
# 精排预算（§7.3「精排超时（> 800 毫秒）」→ 降级为按名次取，审计记 rerank_timeout）
# 本地 TEI CPU 实测：8 条真实切片正文 1.8–3.6s（含长表格），800ms 必然超时；
# 正文截到 RERANK_TEXT_MAX_CHARS 后 8 条约 2.1s，但零候选修复后部分问题有 44 条候选，
# 分两批（TEI 上限 32）实测 8.8–9.7s，所以预算取 12000ms；超时降级与审计不变。
RERANK_BUDGET_MS=12000
# 进精排的正文字符上限：真实长表格切片可达万字，TEI CPU 上 8 条原文 3.6–9.4s；
# 截到 400 字后同批稳定 2.1s。证据包仍用原文，这里只影响相关性打分。
RERANK_TEXT_MAX_CHARS=400
# 同一父片最多保留几条子片（§7.2「最多保留两条」）
PARENT_CHILD_KEEP=2
# 门控临界带（§8.1「最高分在 0.38–0.42 之间按辅助条件决定」）
GATE_BORDERLINE_LOW=0.38
GATE_BORDERLINE_HIGH=0.42
# 澄清触发：两份文档分数差小于这个值（§8.2「差小于 0.05」）
CLARIFY_SCORE_DELTA=0.05
# 澄清选项上限（§8.2「最多四个」）
CLARIFY_OPTIONS_MAX=4
# 拒答时给出的疑似文档上限（§8.1「≤3 份」）
SUSPECTED_DOCS_MAX=3
# 复杂问题的有效证据段落下限（§8.1「复杂问题要求 ≥2 条分属不同段落」）
EVIDENCE_MIN_PARAS=2
# Evidence budget (chars)
EVIDENCE_MAX_CHARS=6000

# --- Auth / dev identity (fixed JWT, claims per 详细设计.md) ---
AUTH_MODE=fixed_jwt
AUTH_JWT_SECRET=dev-only-change-me
AUTH_JWT_ALG=HS256
AUTH_JWT_USER_ID_CLAIM=sub
AUTH_JWT_DEPTS_CLAIM=user_depts
AUTH_JWT_ROLES_CLAIM=user_roles
AUTH_JWT_ADMIN_CLAIM=admin
# Dev fixtures (used by tests / mock login once AUTH_MODE=mock_header)
AUTH_MOCK_USER_ID=u_dev
AUTH_MOCK_DEPTS=fin,corp
AUTH_MOCK_ROLES=staff
AUTH_MOCK_ADMIN=false

# --- API runtime knobs (infra defaults; business values above are required) ---
# DB pool / connect timeout
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_CONNECT_TIMEOUT_S=3
# Per-dependency timeouts for model gateway calls
QDRANT_TIMEOUT_S=5
EMBEDDING_TIMEOUT_S=10
RERANK_TIMEOUT_S=10
LLM_TIMEOUT_S=30
# LLM 网关 resilience：共享 keep-alive 连接池 + 有界重试（应对第三方 SLB 的
# SSL UNEXPECTED_EOF 握手抖动，实测偶发 ~20s 连续失败窗口）。预算 45s 仅覆盖
# 失败路径；成功请求不受影响。QA_BUDGET_S 仍保持 30 不变。
LLM_MAX_ATTEMPTS=6
LLM_RETRY_BACKOFF_S=0.3
LLM_RETRY_BUDGET_S=45
VLM_TIMEOUT_S=60
# /healthz probe budget per dependency (ms)
HEALTH_PROBE_TIMEOUT_MS=1500
# §11.4 limits
QA_BUDGET_S=30
MAX_QUESTION_CHARS=500
QA_MAX_CONCURRENCY=8
# §11.2 audit retention (days) — one year by default
AUDIT_RETENTION_DAYS=365
# --- Ingest (A1: sample scan / ingest_jobs) ---
# 开发期摄取扫目录，不走上传（详细设计.md §3.1）。容器内是 /app/samples（compose 挂 ../:/app）。
INGEST_SAMPLES_DIR=samples
# Retry budget for a failed ingest job: 1 attempt + N retries (§4.4 "重试三次转人工").
INGEST_MAX_RETRIES=3
# Empty-queue poll interval for the resident ingest worker (seconds).
INGEST_POLL_INTERVAL_S=10
# --- Vector sync / reclaim (A3, §4.2 / §4.3) ---
# 同步失败的总尝试次数（1 次 + 3 次重试，与 §4.2 "重试三次" 同口径）。
VECTOR_SYNC_MAX_ATTEMPTS=4
# 退避基数（秒）：1s / 2s / 4s。翻牌后必须一分钟内同步完，不能指数退避到十分钟。
VECTOR_SYNC_BACKOFF_S=1.0
# worker 轮询间隔（秒）。§4.2 要求"翻牌后一分钟内同步完"。
VECTOR_SYNC_INTERVAL_S=10
# 每 N 轮做一次全量对账（0 = 不做）。对账要滚动整个集合，比 drain 贵。
VECTOR_SYNC_RECONCILE_EVERY=10
# 旧版本保留窗口（小时）：§4.3 "保留 24 小时，给回滚留门"。
VECTOR_RETENTION_HOURS=24
# 切片图目录（§3.4 裁图 figures/{chunk_id}.webp），回收时一起清。
FIGURES_DIR=figures
# Run SQL migrations at api container start (dev convenience)
RUN_MIGRATIONS=1
