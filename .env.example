# =========================
# ai-rag local dev (.env)
# Copy to .env and adjust.
# =========================

# --- General ---
TZ=Asia/Shanghai
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL (PG is source of truth) ---
# Image must ship the pgvector extension: chunks.embedding_dense is vector(512).
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=ai_rag
POSTGRES_USER=ai_rag
POSTGRES_PASSWORD=ai_rag_dev_password
POSTGRES_PORT=5432
# Host-side DSN for running `pytest -c api/pytest.ini` or the app outside Docker.
# In-container api/worker get their own DSN assembled in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://ai_rag:ai_rag_dev_password@127.0.0.1:5432/ai_rag

# --- Qdrant (dense + BM25 sparse in one collection) ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=kb_chunks
QDRANT_URL=http://127.0.0.1:6333

# --- API / Web ---
API_PORT=8000
WEB_PORT=5173

# --- Model services (all-in-docker, CPU) ---
# embedding/rerank run as local CPU containers (Hugging Face TEI).
# Models per 详细设计.md: bge-small-zh-v1.5 (512 维稠密) + bge-reranker-base.
# To switch to an external OpenAI-compatible gateway, override the *_BASE_URL/*_API_KEY.
# Endpoints: embeddings -> POST {EMBEDDING_BASE_URL}/embeddings (OpenAI style)
#            rerank     -> POST {RERANK_BASE_URL}/rerank       (TEI native: {"query","texts"})
EMBEDDING_PORT=7997
EMBEDDING_BASE_URL=http://embedding:8000/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

RERANK_PORT=7999
RERANK_BASE_URL=http://rerank:8000
RERANK_API_KEY=local
RERANK_MODEL=BAAI/bge-reranker-base

# Batch size cap for the model services
MODEL_BATCH_SIZE=32
# Optional Hugging Face mirror if huggingface.co is blocked, e.g. https://hf-mirror.com
HF_ENDPOINT=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# --- Retrieval / gate thresholds (from 详细设计.md) ---
# Gate: <GATE_REJECT_NONE => reject, [NONE,LOW) => low-confidence reject+suspects, >=LOW => pass to checks
GATE_REJECT_NONE=0.20
GATE_REJECT_LOW=0.40
# Multi-hop max
MAX_HOPS=3
# Retrieval: per-route topK, rerank window
RETRIEVAL_TOP_K=30
RERANK_TOP_N_MIN=5
RERANK_TOP_N_MAX=8
# Evidence budget (chars)
EVIDENCE_MAX_CHARS=6000

# --- Auth / dev identity (fixed JWT, claims per 详细设计.md) ---
AUTH_MODE=fixed_jwt
AUTH_JWT_SECRET=dev-only-change-me
AUTH_JWT_ALG=HS256
AUTH_JWT_USER_ID_CLAIM=sub
AUTH_JWT_DEPTS_CLAIM=user_depts
AUTH_JWT_ROLES_CLAIM=user_roles
AUTH_JWT_ADMIN_CLAIM=admin
# Dev fixtures (used by tests / mock login once AUTH_MODE=mock_header)
AUTH_MOCK_USER_ID=u_dev
AUTH_MOCK_DEPTS=fin,corp
AUTH_MOCK_ROLES=staff
AUTH_MOCK_ADMIN=false

# --- API runtime knobs (infra defaults; business values above are required) ---
# DB pool / connect timeout
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_CONNECT_TIMEOUT_S=3
# Per-dependency timeouts for model gateway calls
QDRANT_TIMEOUT_S=5
EMBEDDING_TIMEOUT_S=10
RERANK_TIMEOUT_S=10
LLM_TIMEOUT_S=30
VLM_TIMEOUT_S=60
# /healthz probe budget per dependency (ms)
HEALTH_PROBE_TIMEOUT_MS=1500
# §11.4 limits
QA_BUDGET_S=30
MAX_QUESTION_CHARS=500
QA_MAX_CONCURRENCY=8
# §11.2 audit retention (days) — one year by default
AUDIT_RETENTION_DAYS=365
# Run SQL migrations at api container start (dev convenience)
RUN_MIGRATIONS=1
